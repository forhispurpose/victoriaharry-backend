# Copy this file to .env for local testing only.
# On Render, set these as "Environment Variables" in the service settings instead —
# never commit real values to git.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-from-supabase-project-settings-api

# Comma-separated list of origins allowed to call this API.
FRONTEND_ORIGINS=https://victoriaharryinteriors.com,https://www.victoriaharryinteriors.com,http://localhost:8811

PORT=7860
